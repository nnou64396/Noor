<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher background: a deep-navy to royal-blue vertical wash.
  Kept dark so the light-blue mark and the gold centre both stay legible
  regardless of the wallpaper behind a translucent launcher.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF0B2545"
        android:startColor="#FF17406E"
        android:type="linear" />
</shape>
